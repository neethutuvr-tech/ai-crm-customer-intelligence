# Copy this file to .env. Never commit .env or API keys.
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra

# Optional local OpenAI-compatible server (for example, an Ollama server).
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Local Hugging Face models. First launch downloads model weights.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
VECTOR_DB_PATH=data/index/qdrant
VECTOR_COLLECTION=crm_knowledge
QDRANT_URL=
QDRANT_API_KEY=

